<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="min-h-screen bg-zinc-900 p-10 text-white">
        <div class="nav mb-10">
            <a class="text-blue-500" href="/read">Read Users</a>
        </div>
        <h1 class="text-3xl tracking-tighter mb-1">Update User</h1>
        <form action="/update/<%= user._id %>" method="post">
            <input type="text" name="name" placeholder="name" value="<%= user.name %>"
                class="mt-2 ml-10 px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent">
            <input type="text" name="email" placeholder="email" value="<%= user.email %>"
                class="mt-2 ml-10 px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent">
            <input type="text" name="imageurl" placeholder="image url" value="<%= user.image %>"
                class="mt-2 ml-10 px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent">
            <input type="submit" value="update user" class="px-5 py-2 bg-yellow-500 text-black rounded-lg ml-3">
        </form>
    </div>
</body>
</html>