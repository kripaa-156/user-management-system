<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="min-h-screen bg-zinc-900 p-10 text-white">
        <a class="text-blue-500" href="/">Back To Home</a>
        <h1 class="text-3xl tracking-tighter mb-1">All Users</h1>
        <div class="users flex gap-3 flex-wrap">
            <% if (users.length>0){ %>
                <% users.forEach(function(user){ %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                    <div class="w-full h-76 rounded-lg bg-zinc-700 overflow-hidden">
                        <img class="w-full h-full object-cover" src="<%= user.image %>" alt="User image">
                    </div>

                    <h3 class="text-xl mt-3 tracking-tighter">
                        <%= user.name %>
                    </h3>
                    <h5 class="text-zinc-500">
                        <%= user.email %>
                    </h5>

                    <div class="flex gap-3">
                        <a class="text-zinc-200" href="/edit/<%= user._id %>">Edit User</a>
                        <a class="text-red-500" href="/delete/<%= user._id %>">Delete User</a>
                    </div>
                </div>
                <% }) %>
            <% } else{ %>
                <h3>No Users Yet</h3>
            <% } %>
        </div>
    </div>
</body>

</html>