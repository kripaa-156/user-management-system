<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Page</title>
    <!-- <link rel="stylesheet" href="/public/stylesheets/style.css"> -->
    <!-- In Express, when we configure express.static() with the public directory, that directory becomes the root for static file URLs. Therefore, a file at public/stylesheets/style.css is accessed using /stylesheets/style.css, without including /public in the URL -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="min-h-screen bg-zinc-900 p-10 text-white">
        <div class="nav mb-10">
            <a class="text-blue-500" href="/read">Read Users</a>
        </div>
        <h1 class="text-3xl tracking-tighter mb-1">Create User</h1>
        <form action="/create" method="post">
            <input type="text" name="name" placeholder="name"
                class="mt-2 ml-10 px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent">
            <input type="text" name="email" placeholder="email"
                class="mt-2 ml-10 px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent">
            <input type="text" name="imageurl" placeholder="image url"
                class="mt-2 ml-10 px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent">
            <input type="submit" value="create user" class="px-5 py-2 bg-blue-500 rounded-lg ml-3">
        </form>
    </div>
</body>
</html>